VisionAmuletTextList: {
	2: "[s:InfernalEclipseAPI/IEoRIcon] 增加8%攻击速度"
	3: "[s:InfernalEclipseAPI/IEoRIcon] 增加4%暴击率，击败地狱守护者后提高至8%"
	4: "[s:InfernalEclipseAPI/IEoRIcon] 增加8%暴击伤害，击败地狱守护者后提高至12%"
	6:
		'''
		增加20点最大生命值
		[s:InfernalEclipseAPI/IEoRIcon] 增加5%伤害，击败地狱守护者后提高至10%
		'''
}

VisionAmuletTextList2: {
	1:
		'''

		[s:InfernalEclipseAPI/IEoRIcon] 降低15%魔力消耗，击败地狱守护者后提高至20%
		'''
	2:
		'''

		[s:InfernalEclipseAPI/IEoRIcon] 增加8%近战攻速和移动速度
		增加跳跃速度
		'''
	3:
		'''

		可访问工作台，熔炉，和铁砧制作站
		[s:InfernalEclipseAPI/IEoRIcon] 击败地狱守护者后，可访问炼药桌
		增加40点最大魔力值和从药水恢复的魔力值
		'''
	4:
		'''

		[s:InfernalEclipseAPI/IEoRIcon] 增加所有伤害，增加量为从其他来源获得的其他伤害类型加成的10%
		'''
	5:
		'''

		[s:InfernalEclipseAPI/IEoRIcon] 降低5%敌人的防御效果，击败地狱守护者后提高至10%
		'''
}

NPCs.CorpseBloom.DisplayName: 腐尸之花

Items: {
	Sharanga.DisplayName: 考丹达
	Dreamcatcher.DisplayName: 梦境护符
	EnchantedPickaxe.DisplayName: 奥秘镐
	VigorPotion.Tooltip: 获得25次冲刺的能力
	HarvestersScythe.Tooltip:
		'''
		增加5%暴击伤害
		敌人有10%的概率掉落双倍的战利品，被暴击击杀时概率提高至20%
		'''
	RockCandy.Tooltip:
		'''
		[s:InfernalEclipseAPI/IEoRIcon] 增加4点镐力
		增加5%挖矿速度，近战攻速和移动速度
		'''
	HydrokineticAntennae.Tooltip:
		'''
		使用流体动力来延伸近战武器和其它短距离武器的生效范围，例如鞭子
		[s:InfernalEclipseAPI/IEoRIcon] 降低15%真近战伤害
		'''
	FrostArtifactHelmet.Tooltip: "[s:InfernalEclipseAPI/IEoRIcon] 增加15%近战和远程伤害"
	FrostArtifactChestplate.Tooltip: "[s:InfernalEclipseAPI/IEoRIcon] 增加15%近战和远程暴击率"

	ElementalBreastplate: {
		DisplayName: 元素胸甲
		Tooltip:
			'''
			增加10%近战和召唤伤害
			增加4点生命恢复速度
			按下'{0}'键传送至鼠标处，对你路径上的所有敌人造成你防御值的200%点伤害
			有15秒冷却时间，但在冷却期间会增加40%近战攻速
			'''
	}

	TwilightAssassinsCirclet.Tooltip:
		'''
		[s:InfernalEclipseAPI/IEoRIcon] 增加1个哨兵栏
		增加7%召唤和近战伤害
		增加50点最大虚空值
		获得一只全息之眼协助战斗
		按下'{0}'键会使其射出一道施加4级不稳定化的不稳定光束，但每个敌人只会被施加一次
		不稳定化的敌人受到暴击的概率额外提高5个百分点
		发射会消耗6点虚空值
		全息之眼在物品栏中被收藏或装备于装饰栏时仍会保持激活，但不会攻击
		'''
	ChallengerRing.I6: 武器命中时会施加随机减益
}

