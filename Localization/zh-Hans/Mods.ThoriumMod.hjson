	ShootingStarHat.SetBonus:
		'''
		使咒音增幅持续时间延长6秒
		玩家拥有的每个独特的咒音增幅会增加2.5%音波伤害
		你所拥有的每一种独特的能力都可以让灵感回复率提高2%
		'''

	SoulofPlight: {
		DisplayName: 恶意之魂
		Tooltip: “可恶生物的精华”
	}

