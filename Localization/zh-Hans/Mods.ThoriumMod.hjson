ThrowerTechniques: {
	Decoy: {
		DisplayName: 引敌诱饵
		Description:
			'''
			召唤一个敌怪诱饵，并提升攻击速度，持续1秒
			诱饵会试图吸引附近敌怪的注意力
			'''
	}

	BloodLotus: {
		DisplayName: 绽血莲华
		Description:
			'''
			原地静止，向最近的敌怪释放刀刃洪流
			每个刀刃命中时都会为你回复10%伤害的生命值
			刀刃洪流使玩家获得100点防御，但是防御会在玩家受击时消失
			'''
	}

	SmokeBomb: {
		DisplayName: 匿踪迷弹
		Description:
			'''
			扔出一个烟雾弹
			获得短暂的无敌帧并提升攻击速度，持续2秒
			'''
	}
