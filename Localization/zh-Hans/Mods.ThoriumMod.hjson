	}

	MasterMarksmansScouter.Tooltip:
		'''
		“火药会淘汰弱者”
		最近的敌怪会被狙击并多受各种来源10%伤害
		你的远程伤害会对敌怪施加诅咒火焰
		'''
	AssassinsGuard.Tooltip:
		'''
		增加16%远程伤害
		增加15%远程暴击率
		降低25%消耗弹药的概率
		'''

	Kinetoscythe: {
		DisplayName: 动能镰刀
		Tooltip:
			'''
			快速在你周围旋转一把高科技镰刀
			右键生成一个静止的旋转能量镰刀
			在能量镰刀激活时旋转镰刀，使其自动追踪敌怪
			'''
	}

	BlackMIDI: {
		DisplayName: 乌檀电琴
		Tooltip:
			'''
			快速向你的光标位置释放巨量噪声
			黄色噪声会治疗使用者造成伤害0.5%的生命值
			'''
	}

	DreamCatcher: {
		DisplayName: 梦境捕捉器
		Tooltip:
			'''
			在光标位置召唤至多一个梦境捕捉器
			待在梦境捕捉器内会在受到致命伤害时治疗你最大生命值的20%
			复活的玩家会被暂时削弱所有属性，并且2分钟内无法再次复活
			“为了抓住世界的希望并将其置于摇篮之中……”
			'''
	}

