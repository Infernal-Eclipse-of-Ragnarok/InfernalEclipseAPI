Buffs: {
	NinjaBuff.Description: Скорость метательных снарядов увеличена на 20% и шанс метательного критического удара увеличен на 10%
	BloodRush.Description: Скорость добычи увеличена на 15%
}

Items: {
	CapeoftheSurvivor: {
		// DisplayName: Cape of the Survivor
		Tooltip:
			'''
			«В этом плаще соткана магия, которая поможет вам преодолеть даже самые тяжёлые дни»
			Вы быстро накапливаете сопротивление урону до 15% с течением времени
			При получении удара этот бонус временно снижается до -10% сопротивления урону
			Пока этот бонус выше 0%, вы получаете до 2 единиц восполнения здоровья и блокируете 1 атаку, наносящую урон
			'''
	}

	/*
	ScryingGlass: {
	DisplayName: Scrying Glass
	Tooltip: Pressing the '{$Keybinds.AccessoryAbility.DisplayName}' key will toggle an increased range of view
	}
	*/
	
	ShootingStarHat.SetBonus:
		'''
		Увеличивает длительность симфонических усилений на 6 секунд
		Каждое уникальное усиление, наложенное на вас, увеличивает симфонический урон на 2,5% и скорость восстановления вдохновения на 2%
		'''

	SoulofPlight: {
		DisplayName: Эссенция гнева
		Tooltip: «Эссенция проклятых существ»
	}

	SoulofPlightinaBottle: {
		DisplayName: Эссенция гнева в банке
		Tooltip: ""
	}

	KeyofPlight: {
		DisplayName: Ключ гнева
		Tooltip: «Заряжен эссенциями множества душ»
	}

	MasterMarksmansScouter.Tooltip:
		'''
		«Порох отсеет слабых»
		Ближайший враг становится объектом наблюдения и получает на 10% больше урона от всех источников
		Стрелковый урон накладывает на врагов дебафф [cbuff:CursedInferno]
		'''
	AssassinsGuard.Tooltip:
		'''
		Увеличивает стрелковый урон на 16%
		Увеличивает шанс стрелкового критического удара на 15%
		Даёт 25% шанс не потратить боеприпасы
		'''

	Kinetoscythe: {
		// DisplayName: Kineto-scythe
		Tooltip:
			'''
			Стремительно вращает вокруг вас высокотехнологичную косу
			Нажмите ПКМ, чтобы создать неподвижную вращающуюся энергетическую косу
			Вращайте косу пока активна энергетическая коса, чтобы навести её на ближайших врагов
			'''
	}

	BlackMIDI: {
		// DisplayName: Black MIDI
		Tooltip:
			'''
			Стремительно выпускает каскад шумов в направлении курсора
			Жёлтый шум лечит владельца на 0,5% от нанесённого урона
			'''
	}

	DreamCatcher: {
		// DisplayName: Dream Catcher
		Tooltip:
			'''
			«Поймать и лелеять надежды мира...»
			Призывает до одного ловца снов в точке курсора
			Пребывание внутри ловца снов восстановит 20% вашего здоровья при получении смертельного урона
			Временно ослабляет характеристики возрождённых игроков и не даёт им возрождаться в течении следующих 2 минут
			'''
	}

	LifeQuartzClaymore: {
