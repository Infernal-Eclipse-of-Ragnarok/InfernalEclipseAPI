	MagmaSeersMask.Tooltip:
		'''
		«Повелевайте армией, укреплённой магмой»
		Увеличивает урон призывателя на 50%
		Увеличивает максимальное количество миньонов и стражей на 2
		Увеличивает отбрасывание миньонов
		'''
	CursedFlailCore.Tooltip:
		'''
		При первом попадании по врагу цепное оружие гарантировано выпустит проклятый шипастый шар
		Последующие попадания цепным оружием также могут с определённым шансом выпустить дополнительные проклятые шипастые шары
		Проклятый шипастый шар накладывает дебафф [cbuff:CursedInferno]
		'''
	VileFlailCore.Tooltip:
		'''
		При первом попадании по врагу цепное оружие гарантировано выпускает мерзкий шипастый шар
		Последующие попадания цепным оружием также могут с определённым шансом выпустить дополнительные мерзкие шипастые шары
		Мерзкий шипастый шар накладывает дебафф [cbuff:Ichor]
		'''
	IronFlailCore.Tooltip:
		'''
		При первом попадании по врагу цепное оружие гарантировано выпускает катящийся шипастый шар
		Последующие попадания цепным оружием также могут с определённым шансом выпустить дополнительные катящиеся шипастые шары
		'''
	BloomingShield.Tooltip:
		'''
		Постепенно генерирует до 20 ед. жизненного щита
		Увеличивает бонусное исцеление на 1 ед. здоровья
		При достижении максимального щита это значение увеличивается до 2 ед.
		Вне боя восполнение здоровья постепенно увеличивается до 5 ед.
		'''
	AstroBeetleHusk.Tooltip:
		'''
		Увеличивает сопротивление урону на 5%
		Постепенно генерирует до 50 ед. жизненного щита
		'''
}

ThrowerTechniques: {
	Decoy: {
		DisplayName: Приманка
		Description:
			'''
			Призывает вражескую приманку и даёт 1-секундный бонус к скорости атаки
			Приманка попытается привлечь внимание ближайших врагов
			'''
	}

	BloodLotus: {
		DisplayName: Кровавый лотос
		Description:
			'''
			Вы замираете на месте и выпускаете поток ножей в ближайшего врага
			Каждый нож восстанавливает вам до 10% здоровья от нанесённого урона
			Поток даёт игроку бонус на 100 ед. брони, испаряющийся при получении урона
			'''
	}

