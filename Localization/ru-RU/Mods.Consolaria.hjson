Items: {
	OstaraHat: {
		// DisplayName: Hat of Ostara
		Tooltip: Увеличивает скорость передвижения на 7%
		SetBonus:
			'''
			Позволяет совершать автопрыжок и даёт невосприимчивость к урону от падения
			Прыжок выбрасывает вперёд 5 пробивающих ножей
			'''
	}

	JadeSeal: {
		// DisplayName: Jade Seal
		Tooltip:
			'''
			Нажмите ЛКМ, чтобы призвать нефритовую лампу, медленно движущуюся в направлении курсора, а также увеличивающую урон и защиту всех союзников, находящихся в радиусе действия её ауры
			Нажмите ПКМ, чтобы призвать золотую лампу, парящую на месте и исцеляющую всех союзников, находящихся в радиусе действия её ауры
			Только 1 лампа может существовать одновременно
			'''
	}

