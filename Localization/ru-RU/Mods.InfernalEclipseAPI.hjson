			Не расходуется
			'''
	}

	EldritchBattleHorn: {
		DisplayName: Элдрический боевой рог
		Tooltip:
			'''
			Призывает Забытого при использовании в акватических глубинах
			Не расходуется
			'''
	}

	InfernalArsenalPainting: {
		DisplayName: Картина «Infernal Arsenal»
		Tooltip:
			'''
			Спасибо всем, кому всё-таки удалось либо пройти полный Босс-раш, либо всю игру на low%!
			Эта картина слишком мала, чтобы уместить всех победителей
			Победители перечисленны в порядке прохождения указанного испытания
			Удерживайте SHIFT, чтобы увидеть полный список
			'''
	}

	BlixerCore: {
		DisplayName: Ядро Бликсера
		Tooltip:
			'''
			Призывает руки Бликсера сражаться за вас
			Руки занимают 4 слота миньонов и могут быть призваны лишь в одном экземпляре
			Нажатие ПКМ позволяет переключаться между 2 разными режимами атаки
			'''
		DefaultMode:
			'''
			Базовый режим:
			Комплект из 2 ладоней и 2 пушек будет прикреплён к рукам
			Ладони автоматически атакуют ближайших врагов, находящихся в зоне досягаемости
			Пушки будут стрелять в направлении вашего курсора во время использования любого предмета
			'''
		LaserMode:
			'''
			Режим лазера:
			Комплект из 4 пушек будет прикреплён к рукам
			Пушки будут стрелять в направлении вашего курсора во время использования любого предмета
			'''
	}

